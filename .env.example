NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://cicd_user:cicd_pass@localhost:5432/cicd_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth & Webhooks ───────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=change_this_webhook_secret
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# ── GitHub OAuth ──────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback
BACKEND_URL=http://localhost:3000

# ── Integrations ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
FRONTEND_URL=http://localhost:5173

